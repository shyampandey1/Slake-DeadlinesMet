rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is an admin
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'shyamp028@gmail.com' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isReformersAdmin == true
      );
    }

    // Leaderboard & User Profiles
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow update: if request.auth != null && (
        request.auth.uid == userId || 
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followersCount', 'coWorkerId', 'pendingCoWorkerId'])
      );
      allow delete: if isAdmin();
      
      // Follow feature exceptions:
      match /user_followers/{followerId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && (request.auth.uid == followerId || isAdmin());
      }

      match /user_following/{followingId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }
      
      // Strict access to private subcollections (tasks, calendar events, routines)
      // Only the authenticated owner can read or write their personal productivity data
      match /tasks/{taskId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }

      match /userEvents/{eventId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }

      match /userPresetTasks/{presetTaskId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }

      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }
    }

    // Global settings access
    match /config/{configId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Direct Messages system (Payload is end-to-end encrypted with AES-GCM 256-bit client keys)
    match /messages/{messageId} {
      allow read, write: if request.auth != null;
    }

    // Cross-Device Active Sessions
    match /active_sessions/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Co-op Sessions (Collaborative Model)
    match /coop_sessions/{sessionId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      // Any participant or creator can update timer state or join
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.createdBy ||
        request.auth.uid in resource.data.participants ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants'])
      );
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.createdBy ||
        request.auth.uid in resource.data.participants
      );
    }

    // Reward Redemption Requests
    match /redemption_requests/{requestId} {
      allow read, write: if request.auth != null;
    }

    // Admin Notifications
    match /admin_notifications/{notifId} {
      allow read, write: if request.auth != null;
    }
    
    // Deny access to everything else by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
