rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is an admin
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'shyamp028@gmail.com' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isReformersAdmin == true
      );
    }

    // Leaderboard access: any logged-in user can read profiles, but only write their own OR if admin
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      
      // Strict access to subcollections (sensitive tasks, calendar events, streaks mapping)
      match /{allSubcollections=**} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }
    }

    // Global settings access
    match /config/{configId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Direct Messages system
    match /messages/{messageId} {
      allow read, write: if request.auth != null;
    }

    // Cross-Device Active Sessions
    match /active_sessions/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Co-op Sessions (Coach-Led Model)
    match /coop_sessions/{sessionId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      // Members can only update the participants list to join. Only the Coach (createdBy) can change timer state.
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.createdBy ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants'])
      );
      allow delete: if request.auth != null && request.auth.uid == resource.data.createdBy;
    }
    
    // Deny access to everything else by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
