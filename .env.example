# Gemini & Speech
GEMINI_API_KEY="your_gemini_api_key"
TTS_PROVIDER="google" # "google" | "elevenlabs"
GOOGLE_TTS_API_KEY="your_google_cloud_tts_api_key"
ELEVENLABS_API_KEY="" # optional secondary provider

# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY="your_firebase_api_key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your_project_id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your_project_id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your_project_id.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your_messaging_sender_id"
NEXT_PUBLIC_FIREBASE_APP_ID="your_firebase_app_id"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="your_measurement_id"

# Weather API
NEXT_PUBLIC_OPENWEATHERMAP_API_KEY="your_openweather_api_key"
NEXT_PUBLIC_OPENWEATHER_API_KEY="your_openweather_api_key"

# JEV TypeSafe Decision Engine
JEV_API_KEY="your_jev_api_key"
JEV_API_BASE_URL="https://api.typesafe.ai/v1"
